{
  "name": "fireshare",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild src/worker/main.ts --bundle --platform=node --target=node22 --format=cjs --external:pg-native --outfile=dist/worker.cjs",

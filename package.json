    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "drizzle-orm": "0.45.4",
    "framer-motion": "^14.3.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "2.10.3",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "yauzl": "3.2.0"
  },
  "packageManager": "pnpm@10.28.2"

# Copy to .env and replace every "change-me" value with a long random secret,
# e.g. `openssl rand -hex 24`. Every setting is checked when the app and the
# cleanup worker start; if any is invalid they exit and name each bad one
# (see `docker compose logs app worker`).

# Image version to run: a release such as 1.2.3 or 1.2, "latest" (the newest
# release) or "main" (the newest build of the main branch).
FIRESHARE_VERSION=latest

# Port the web app is published on.
APP_PORT=3000

# PostgreSQL password for the bundled database.
POSTGRES_PASSWORD=change-me-postgres-password

# Root (admin) key of the bundled RustFS storage. Only the one-off
# storage-init container uses it, to create the bucket and the app's key below.
# The secret must be at least 8 characters.
RUSTFS_ROOT_ACCESS_KEY=rustfs-root
RUSTFS_ROOT_SECRET_KEY=change-me-storage-root-secret

# The key the app and the cleanup worker use for storage. With the bundled
# RustFS it's created on start, allowed into S3_BUCKET only, and must differ
# from the root key. With external storage, give a key limited the same way.
# The secret must be at least 8 characters.
S3_ACCESS_KEY_ID=fireshare-app
S3_SECRET_ACCESS_KEY=change-me-storage-app-secret

# Uploaders enter this once per browser; people you send links to never need
# it. The app won't start without one unless ALLOW_PUBLIC_UPLOAD=true.
UPLOAD_PASSWORD=change-me-upload-password

# Set to true (and leave UPLOAD_PASSWORD empty) to let anyone upload. Download
# pages then link to ABUSE_CONTACT, an email address or http(s) URL, which is
# required in that case.
# ALLOW_PUBLIC_UPLOAD=true
# ABUSE_CONTACT=abuse@example.com

# Optional: only accept uploads from these networks, as a comma-separated list
# of IP addresses or CIDR ranges (IPv4 or IPv6). Downloads work from anywhere.
# UPLOAD_ALLOWED_IPS=192.168.1.0/24,10.8.0.0/16

# Addresses of reverse proxies in front of the app. Only requests from these
# have their X-Forwarded-For believed; from anywhere else it's ignored and the
# connection's address counts as the client's. Leave empty without a proxy.
# TRUSTED_PROXIES=172.16.0.0/12

# Bucket that holds the files; created on first start, private (no anonymous
# access). 3 to 63 lowercase letters, digits, dots and hyphens.
S3_BUCKET=fireshare

# Region sent to the storage API. RustFS accepts any value.
S3_REGION=us-east-1

# Expiry presets the uploader picks from, as a comma-separated list of whole
# hours or days (e.g. 12h, 7d). A share's link stops working once its expiry
# has passed, counted from when its upload finished; it can't be extended.
EXPIRY_OPTIONS=1d,3d,7d,14d,30d
# Preselected preset; must be one of EXPIRY_OPTIONS.
EXPIRY_DEFAULT=7d

# Once a share expires or is deleted early, its link stops working at once,
# but its files stay in storage for this long so downloads already under way
# can finish (minutes, hours or days: 30m, 1h, 2d; 0m deletes at once).
DELETE_GRACE=1h
# Uploads never finished are removed, with everything they stored, once they
# are this old.
PENDING_TTL=24h

# Browsers upload each file in chunks of this size, from 5MB to 5GB (KB, MB
# or GB; 1MB = 1024 x 1024 bytes). An interrupted upload resumes from its last
# completed chunk, so smaller chunks lose less on a dropped connection.
UPLOAD_CHUNK_SIZE=64MB
# How many files a browser uploads at the same time, from 1 to 10.
UPLOAD_PARALLEL_FILES=3

# Limits and quotas. Each is off when left empty. Sizes are in KB, MB, GB or
# TB (1GB = 1024 x 1024 x 1024 bytes). Uploads over a limit are refused before
# any bytes are sent, with the reason shown to the uploader.
# Total size of one share, and how many files it may hold.
MAX_SHARE_SIZE=50GB
MAX_FILES_PER_SHARE=500
# Total size of all shares still uploading or not yet expired.
MAX_TOTAL_STORAGE=
# Per client IP: bytes uploaded in any 24 hours, and shares still uploading or
# not yet expired. Recommended with ALLOW_PUBLIC_UPLOAD=true.
UPLOAD_QUOTA_PER_IP=
MAX_ACTIVE_SHARES_PER_IP=
# Requests per minute per client IP. Every uploaded chunk is one request, so
# keep RATE_LIMIT_UPLOAD well above (upload speed / UPLOAD_CHUNK_SIZE) x 60.
# Every file download, and every resume of one, is one request.
RATE_LIMIT_UPLOAD=600
RATE_LIMIT_DOWNLOAD=300

# Transfer mode: "proxy" (default) streams all uploads and downloads through
# the app; "direct" issues short-lived presigned URLs so browsers transfer
# files straight to and from storage at STORAGE_DIRECT_ENDPOINT (which must be
# https://, e.g. via a reverse proxy such as Caddy). In direct mode the app
# automatically configures the bucket's CORS rule (AllowedOrigins: APP_ORIGIN
# or the request's origin, AllowedMethods: GET/PUT/HEAD, ExposeHeaders: ETag).
# "auto" uses direct for clients in DIRECT_NETWORKS and proxy for everyone
# else, chosen per request by the client IP (see TRUSTED_PROXIES above).
# TRANSFER_MODE=proxy
# STORAGE_DIRECT_ENDPOINT=https://storage.local:9000
# APP_ORIGIN=https://share.local
# Required with TRANSFER_MODE=auto, and only allowed then: the networks that
# transfer directly, e.g. the LAN and VPN, as a comma-separated list of IP
# addresses or CIDR ranges (IPv4 or IPv6). They must be able to reach
# STORAGE_DIRECT_ENDPOINT. An upload that went direct resumes only from these.
# DIRECT_NETWORKS=192.168.1.0/24,10.8.0.0/16

# Set by compose.yaml for the bundled services. Only set these yourself when
# running the app outside Compose (e.g. `pnpm dev`) or with external storage:
# the PostgreSQL connection URL, and the http(s) URL of the S3 API.
# DATABASE_URL=postgres://fireshare:change-me-postgres-password@localhost:5432/fireshare
# S3_ENDPOINT=http://localhost:9000

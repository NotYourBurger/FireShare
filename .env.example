# Copy to .env and replace every "change-me" value with a long random secret,
# e.g. `openssl rand -hex 24`.

# Port the web app is published on.
APP_PORT=3000

# PostgreSQL password for the bundled database.
POSTGRES_PASSWORD=change-me-postgres-password

# Credentials of the bundled RustFS storage, used by both RustFS and the app.
# The secret key must be at least 8 characters.
S3_ACCESS_KEY_ID=fireshare
S3_SECRET_ACCESS_KEY=change-me-storage-secret

# Bucket that holds the files; created on first start.
S3_BUCKET=fireshare

# Region sent to the storage API. RustFS accepts any value.
S3_REGION=us-east-1

# Set by compose.yaml for the bundled services. Only set these yourself when
# running the app outside Compose (e.g. `pnpm dev`) or with external storage.
# DATABASE_URL=postgres://fireshare:change-me-postgres-password@localhost:5432/fireshare
# S3_ENDPOINT=http://localhost:9000
